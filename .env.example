# GitHub API access (required). A classic PAT with `public_repo` scope is
# enough for public repos. Never commit your real .env — it's gitignored.
GITHUB_TOKEN=

# LLM provider: "google" (default), "anthropic", or "openai".
LLM_PROVIDER=google

# Provider keys — only the selected provider's key is required.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model IDs — set the selected provider's model explicitly.
# For the Hack Day, use the open-weight model ID confirmed by the organizers.
GOOGLE_MODEL=
ANTHROPIC_MODEL=
OPENAI_MODEL=
