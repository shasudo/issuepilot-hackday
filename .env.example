# GitHub API access (required). A classic PAT with `public_repo` scope is
# enough for public repos. Never commit your real .env — it's gitignored.
GITHUB_TOKEN=

# LLM provider: "google" (default), "anthropic", "openai", "openrouter", or "groq".
LLM_PROVIDER=google

# Provider keys — only the selected provider's key is required.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Model IDs — set the selected provider's model explicitly.
# For the Hack Day, use the organizer-confirmed ID. Per Google's Gemini API docs,
# the two hosted Gemma 4 IDs are: gemma-4-26b-a4b-it and gemma-4-31b-it.
# OpenRouter equivalent (OpenAI-compatible, generous free tier):
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
GOOGLE_MODEL=
ANTHROPIC_MODEL=
OPENAI_MODEL=
OPENROUTER_MODEL=
GROQ_MODEL=
